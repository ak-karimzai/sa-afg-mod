// Mission 2 - Market Day: Black Stone men are shaking down a stall keeper. Drive them out of the bazaar.
MISSION_START
{
LVAR_INT thug[4] tblip[4] victim civ[3] k alive
GOSUB m2_main
IF HAS_DEATHARREST_BEEN_EXECUTED
    PRINT_BIG M_FAIL 5000 1
ENDIF
GOSUB m2_cleanup
MISSION_END

m2_main:
SCRIPT_NAME AFM2
victim = -1
k = 0
WHILE k < 4
    thug[k] = -1
    tblip[k] = -1
    k += 1
ENDWHILE
k = 0
WHILE k < 3
    civ[k] = -1
    k += 1
ENDWHILE
flag_player_on_mission = 1
REGISTER_MISSION_GIVEN
WAIT 0
REQUEST_MODEL 158
REQUEST_MODEL 159
REQUEST_MODEL 128
REQUEST_MODEL 132
REQUEST_MODEL 133
REQUEST_MODEL 247
REQUEST_MODEL 248
REQUEST_MODEL 162
REQUEST_MODEL 346
REQUEST_MODEL 336
LOAD_ALL_MODELS_NOW
GOSUB m2_contact
// the shakedown: thug 0 holds the stall keeper at gunpoint, the others loiter along the lane
CREATE_CHAR PEDTYPE_CIVMALE 247 @thug0@ thug[0]
SET_CHAR_HEADING thug[0] 270.0
CREATE_CHAR PEDTYPE_CIVMALE 248 @thug1@ thug[1]
CREATE_CHAR PEDTYPE_CIVMALE 162 @thug2@ thug[2]
CREATE_CHAR PEDTYPE_CIVMALE 247 @thug3@ thug[3]
GIVE_WEAPON_TO_CHAR thug[0] WEAPONTYPE_PISTOL 200
GIVE_WEAPON_TO_CHAR thug[1] WEAPONTYPE_BASEBALLBAT 1
GIVE_WEAPON_TO_CHAR thug[2] WEAPONTYPE_PISTOL 200
GIVE_WEAPON_TO_CHAR thug[3] WEAPONTYPE_BASEBALLBAT 1
k = 0
WHILE k < 4
    SET_CHAR_STAY_IN_SAME_PLACE thug[k] TRUE
    SET_CHAR_MONEY thug[k] 60
    k += 1
ENDWHILE
CREATE_CHAR PEDTYPE_CIVMALE 159 @m2_victim@ victim
SET_CHAR_HEADING victim @m2_victim.h@
TASK_AIM_GUN_AT_CHAR thug[0] victim 30000
TASK_HANDS_UP victim 30000
CREATE_CHAR PEDTYPE_CIVMALE 128 @m2_civ0@ civ[0]
CREATE_CHAR PEDTYPE_CIVMALE 132 @m2_civ1@ civ[1]
CREATE_CHAR PEDTYPE_CIVMALE 133 @m2_civ2@ civ[2]
k = 0
WHILE k < 3
    TASK_PLAY_ANIM civ[k] IDLE_chat PED 4.0 TRUE FALSE FALSE FALSE -1
    k += 1
ENDWHILE

// ---------------------------------------------------------------- intro cutscene
DO_FADE 400 FADE_OUT
WAIT 450
SET_PLAYER_CONTROL player OFF
SWITCH_WIDESCREEN ON
SET_CHAR_COORDINATES scplayer @talk_bazaar@
SET_CHAR_HEADING scplayer @talk_bazaar.h@
SET_CHAR_COORDINATES contact_ped[0] @bazaar_uncle@
SET_CHAR_HEADING contact_ped[0] @bazaar_uncle.h@
WAIT 600
SET_FIXED_CAMERA_POSITION @cam_m2@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_m2_t@ JUMP_CUT
DO_FADE 400 FADE_IN
PRINT_BIG AF2_T 3000 2
PRINT_NOW AF2_01 4500 1
WAIT 4500
PRINT_NOW AF2_05 4500 1
WAIT 4500
SET_FIXED_CAMERA_POSITION @cam_bazaar_c@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_bazaar_ct@ JUMP_CUT
TASK_PLAY_ANIM contact_ped[0] IDLE_chat PED 4.0 TRUE FALSE FALSE FALSE -1
PRINT_NOW AF2_02 4500 1
WAIT 4500
SET_FIXED_CAMERA_POSITION @cam_bazaar_p@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_bazaar_pt@ JUMP_CUT
CLEAR_CHAR_TASKS contact_ped[0]
PRINT_NOW AF2_06 3500 1
WAIT 3500
GOSUB m2_cut_end

// ---------------------------------------------------------------- the fight
GIVE_WEAPON_TO_CHAR scplayer WEAPONTYPE_PISTOL 85
SET_CURRENT_CHAR_WEAPON scplayer WEAPONTYPE_PISTOL
CLEAR_CHAR_TASKS victim
TASK_SMART_FLEE_CHAR victim thug[0] 100.0 30000
k = 0
WHILE k < 3
    CLEAR_CHAR_TASKS civ[k]
    TASK_SMART_FLEE_CHAR civ[k] thug[0] 120.0 30000
    k += 1
ENDWHILE
k = 0
WHILE k < 4
    SET_CHAR_RELATIONSHIP thug[k] ACQUAINTANCE_TYPE_PED_HATE PEDTYPE_PLAYER1
    SET_CHAR_STAY_IN_SAME_PLACE thug[k] FALSE
    ADD_BLIP_FOR_CHAR thug[k] tblip[k]
    SET_CHAR_ACCURACY thug[k] 40
    TASK_KILL_CHAR_ON_FOOT thug[k] scplayer
    k += 1
ENDWHILE
PRINT_NOW AF2_03 5000 1
mission_counter = 4
DISPLAY_ONSCREEN_COUNTER_WITH_STRING mission_counter COUNTER_DISPLAY_NUMBER AF2_CT

m2_loop:
WAIT 250
alive = 0
k = 0
WHILE k < 4
    IF IS_CHAR_DEAD thug[k]
        IF NOT tblip[k] = -1
            REMOVE_BLIP tblip[k]
            tblip[k] = -1
        ENDIF
    ELSE
        alive += 1
    ENDIF
    k += 1
ENDWHILE
mission_counter = alive
IF alive = 0
    CLEAR_ONSCREEN_COUNTER mission_counter
    WAIT 1500
    GOSUB m2_outro
    RETURN
ENDIF
GOTO m2_loop

// ---------------------------------------------------------------- outro with Rahim
m2_outro:
DO_FADE 400 FADE_OUT
WAIT 450
SET_PLAYER_CONTROL player OFF
SWITCH_WIDESCREEN ON
SET_CHAR_COORDINATES scplayer @talk_bazaar@
SET_CHAR_HEADING scplayer @talk_bazaar.h@
SET_CHAR_COORDINATES contact_ped[0] @bazaar_uncle@
SET_CHAR_HEADING contact_ped[0] @bazaar_uncle.h@
WAIT 600
SET_FIXED_CAMERA_POSITION @cam_bazaar_c@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_bazaar_ct@ JUMP_CUT
DO_FADE 400 FADE_IN
TASK_PLAY_ANIM contact_ped[0] IDLE_chat PED 4.0 TRUE FALSE FALSE FALSE -1
PRINT_NOW AF2_04 5000 1
WAIT 5000
SET_FIXED_CAMERA_POSITION @cam_bazaar_p@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_bazaar_pt@ JUMP_CUT
CLEAR_CHAR_TASKS contact_ped[0]
PRINT_NOW AF2_07 3000 1
WAIT 3000
SET_FIXED_CAMERA_POSITION @cam_bazaar_w@ 0.0 0.0 0.0
POINT_CAMERA_AT_POINT @cam_bazaar_wt@ JUMP_CUT
TASK_PLAY_ANIM contact_ped[0] IDLE_chat PED 4.0 TRUE FALSE FALSE FALSE -1
PRINT_NOW AF2_08 5000 1
WAIT 5000
CLEAR_CHAR_TASKS contact_ped[0]
GOSUB m2_cut_end
mission_progress = 2
ADD_SCORE player 500
PRINT_WITH_NUMBER_BIG M_PASS 500 5000 1
REGISTER_MISSION_PASSED AF2_T
PLAYER_MADE_PROGRESS 1
PLAY_MISSION_PASSED_TUNE 1
RETURN

m2_cut_end:
RESTORE_CAMERA_JUMPCUT
SET_CAMERA_BEHIND_PLAYER
SWITCH_WIDESCREEN OFF
SET_PLAYER_CONTROL player ON
RETURN

m2_contact:
IF NOT DOES_CHAR_EXIST contact_ped[0]
    CREATE_CHAR PEDTYPE_CIVMALE 158 @bazaar_uncle@ contact_ped[0]
    SET_CHAR_HEADING contact_ped[0] @bazaar_uncle.h@
    SET_CHAR_PROOFS contact_ped[0] TRUE TRUE TRUE TRUE TRUE
    SET_CHAR_NEVER_TARGETTED contact_ped[0] TRUE
    SET_CHAR_STAY_IN_SAME_PLACE contact_ped[0] TRUE
ENDIF
RETURN

m2_cleanup:
CLEAR_ONSCREEN_COUNTER mission_counter
k = 0
WHILE k < 4
    IF NOT tblip[k] = -1
        REMOVE_BLIP tblip[k]
        tblip[k] = -1
    ENDIF
    IF NOT thug[k] = -1
        MARK_CHAR_AS_NO_LONGER_NEEDED thug[k]
        thug[k] = -1
    ENDIF
    k += 1
ENDWHILE
k = 0
WHILE k < 3
    IF NOT civ[k] = -1
        MARK_CHAR_AS_NO_LONGER_NEEDED civ[k]
        civ[k] = -1
    ENDIF
    k += 1
ENDWHILE
IF NOT victim = -1
    MARK_CHAR_AS_NO_LONGER_NEEDED victim
    victim = -1
ENDIF
IF DOES_CHAR_EXIST contact_ped[0]
    CLEAR_CHAR_TASKS contact_ped[0]
ENDIF
MARK_MODEL_AS_NO_LONGER_NEEDED 158
MARK_MODEL_AS_NO_LONGER_NEEDED 159
MARK_MODEL_AS_NO_LONGER_NEEDED 128
MARK_MODEL_AS_NO_LONGER_NEEDED 132
MARK_MODEL_AS_NO_LONGER_NEEDED 133
MARK_MODEL_AS_NO_LONGER_NEEDED 247
MARK_MODEL_AS_NO_LONGER_NEEDED 248
MARK_MODEL_AS_NO_LONGER_NEEDED 162
RESTORE_CAMERA_JUMPCUT
SWITCH_WIDESCREEN OFF
SET_PLAYER_CONTROL player ON
flag_player_on_mission = 0
MISSION_HAS_FINISHED
RETURN
}
