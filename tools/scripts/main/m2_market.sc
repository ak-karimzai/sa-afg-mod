// Mission 2 - Market Day: drive the Black Stone extortionists out of the bazaar.
MISSION_START
{
LVAR_INT uncle thug[4] tblip[4] k alive
GOSUB m2_main
IF HAS_DEATHARREST_BEEN_EXECUTED
    PRINT_BIG M_FAIL 5000 1
ENDIF
GOSUB m2_cleanup
MISSION_END

m2_main:
SCRIPT_NAME AFM2
uncle = -1
k = 0
WHILE k < 4
    thug[k] = -1
    k += 1
ENDWHILE
k = 0
WHILE k < 4
    tblip[k] = -1
    k += 1
ENDWHILE
flag_player_on_mission = 1
REGISTER_MISSION_GIVEN
WAIT 0
PRINT_BIG AF2_T 3000 2
REQUEST_MODEL 158
REQUEST_MODEL 247
REQUEST_MODEL 248
REQUEST_MODEL 162
REQUEST_MODEL 346
REQUEST_MODEL 336
LOAD_ALL_MODELS_NOW
CREATE_CHAR PEDTYPE_CIVMALE 158 @bazaar_uncle@ uncle
SET_CHAR_HEADING uncle @bazaar_uncle.h@
SET_CHAR_PROOFS uncle TRUE TRUE TRUE TRUE TRUE
CREATE_CHAR PEDTYPE_MISSION1 247 @thug0@ thug[0]
CREATE_CHAR PEDTYPE_MISSION1 248 @thug1@ thug[1]
CREATE_CHAR PEDTYPE_MISSION1 162 @thug2@ thug[2]
CREATE_CHAR PEDTYPE_MISSION1 247 @thug3@ thug[3]
GIVE_WEAPON_TO_CHAR thug[0] WEAPONTYPE_BASEBALLBAT 1
GIVE_WEAPON_TO_CHAR thug[1] WEAPONTYPE_PISTOL 200
GIVE_WEAPON_TO_CHAR thug[2] WEAPONTYPE_BASEBALLBAT 1
GIVE_WEAPON_TO_CHAR thug[3] WEAPONTYPE_PISTOL 200
SET_PLAYER_CONTROL player OFF
SWITCH_WIDESCREEN ON
PRINT_NOW AF2_01 5000 1
WAIT 5000
PRINT_NOW AF2_02 4000 1
WAIT 4000
SWITCH_WIDESCREEN OFF
SET_PLAYER_CONTROL player ON
SET_CAMERA_BEHIND_PLAYER
GIVE_WEAPON_TO_CHAR scplayer WEAPONTYPE_PISTOL 85
SET_CURRENT_CHAR_WEAPON scplayer WEAPONTYPE_PISTOL
k = 0
WHILE k < 4
    ADD_BLIP_FOR_CHAR thug[k] tblip[k]
    SET_CHAR_ACCURACY thug[k] 40
    TASK_KILL_CHAR_ON_FOOT thug[k] scplayer
    k += 1
ENDWHILE
PRINT_NOW AF2_03 5000 1

m2_loop:
WAIT 250
alive = 0
k = 0
WHILE k < 4
    IF IS_CHAR_DEAD thug[k]
        IF NOT tblip[k] = -1
            REMOVE_BLIP tblip[k]
            tblip[k] = -1
        ENDIF
    ELSE
        alive += 1
    ENDIF
    k += 1
ENDWHILE
IF alive = 0
    PRINT_NOW AF2_04 6000 1
    WAIT 2000
    mission_progress = 2
    ADD_SCORE player 500
    PRINT_WITH_NUMBER_BIG M_PASS 500 5000 1
    REGISTER_MISSION_PASSED AF2_T
    PLAYER_MADE_PROGRESS 1
    PLAY_MISSION_PASSED_TUNE 1
    RETURN
ENDIF
GOTO m2_loop

m2_cleanup:
k = 0
WHILE k < 4
    IF NOT tblip[k] = -1
        REMOVE_BLIP tblip[k]
        tblip[k] = -1
    ENDIF
    IF NOT thug[k] = -1
        MARK_CHAR_AS_NO_LONGER_NEEDED thug[k]
        thug[k] = -1
    ENDIF
    k += 1
ENDWHILE
IF NOT uncle = -1
    MARK_CHAR_AS_NO_LONGER_NEEDED uncle
    uncle = -1
ENDIF
MARK_MODEL_AS_NO_LONGER_NEEDED 158
MARK_MODEL_AS_NO_LONGER_NEEDED 247
MARK_MODEL_AS_NO_LONGER_NEEDED 248
MARK_MODEL_AS_NO_LONGER_NEEDED 162
flag_player_on_mission = 0
MISSION_HAS_FINISHED
RETURN
}
